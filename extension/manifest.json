{
  "manifest_version": 3,
  "name": "Risk Radar — Website Risk Intelligence",
  "short_name": "Risk Radar",
  "version": "1.0.0",
  "description": "Browser-native digital risk intelligence. Automatically analyzes the website you are visiting to detect scams, gambling, and unknown threats.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "http://127.0.0.1:5000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Risk Radar — Inspect Current Website",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
